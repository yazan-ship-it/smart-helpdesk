# Copy to .env and fill in the values

# ── Database (PostgreSQL, e.g. a free Neon project) ─────────────
# DATABASE_URL: the pooled connection string (host contains "-pooler"), with &pgbouncer=true added
# DIRECT_URL:   the direct connection string (used for migrations)
DATABASE_URL=""
DIRECT_URL=""

# A second, separate database for `npm test`. It is wiped on every run,
# so its name must end in "_test" (e.g. create helpdesk_test in Neon). Direct string.
TEST_DATABASE_URL=""

# ── Sessions ────────────────────────────────────────────────────
# Signs the session cookie. Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# ── AI (optional) ───────────────────────────────────────────────
# Google Gemini for triage suggestions, summaries and translation.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"   # "none" to disable

# ── Attachments ─────────────────────────────────────────────────
# On Vercel: create a *private* Blob store and connect it to the project;
# Vercel then sets this token. Without it, files go to STORAGE_DIR on local disk.
# BLOB_READ_WRITE_TOKEN=""
# STORAGE_DIR=".data/uploads"

# ── Demo ────────────────────────────────────────────────────────
# 1-click demo logins for the seeded accounts on the sign-in page.
# They expose the demo passwords, so only for a demo deployment.
DEMO_MODE="false"
