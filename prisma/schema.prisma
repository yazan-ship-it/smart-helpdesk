// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Used by the app. On Neon: the pooled connection string
  url       = env("DATABASE_URL")
  /// Used by migrations. On Neon: the direct (unpooled) connection string
  directUrl = env("DIRECT_URL")
}

// Roles, statuses and priorities are Strings validated in application code
// (see lib/errors.ts and app/actions), which keeps them easy to extend.

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  /// Role: "EMPLOYEE" | "IT_SUPPORT" | "ADMIN"
  role          String   @default("EMPLOYEE")
  accountStatus String   @default("PENDING")
  /// JSON array of skill categories, e.g. '["Hardware","Network"]'
  skills      String   @default("[]")
  /// Whether the IT agent is currently available for ticket assignment
  isAvailable   Boolean  @default(true)
  /// Copied into the session cookie; incrementing it ends every existing session
  sessionVersion Int     @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  createdTickets  Ticket[]        @relation("CreatedBy")
  assignedTickets Ticket[]        @relation("AssignedTo")
  comments        Comment[]
  ticketHistories TicketHistory[]
  attachments     Attachment[]
}

model Ticket {
  id           String   @id @default(cuid())
  ticketNumber Int      @unique
  title        String
  description  String
  category     String
  /// Priority: "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  priority     String   @default("MEDIUM")
  /// Status: "OPEN" | "ASSIGNED" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"
  status       String   @default("OPEN")
  slaDeadline  DateTime?
  slaBreached  Boolean  @default(false)
  csatRating   Int?
  csatFeedback String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  assetId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  createdById  String
  createdBy    User   @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?  @relation("AssignedTo", fields: [assignedToId], references: [id])

  comments        Comment[]
  ticketHistories TicketHistory[]
  attachments     Attachment[]

  // The queries the lists and counters run: a requester's tickets, an agent's
  // queue, open tickets by status, overdue tickets by deadline
  @@index([createdById])
  @@index([assignedToId, status])
  @@index([status, slaDeadline])
}

/// A file uploaded with a ticket. The bytes are in private storage (lib/storage.ts)
/// and only served through /api/files/[id].
model Attachment {
  id         String   @id @default(cuid())
  /// Key of the file in storage: a random UUID plus the allowed extension
  storageKey String   @unique
  name       String
  size       Int
  /// Derived from the extension on the server, never taken from the browser
  type       String
  createdAt  DateTime @default(now())

  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  /// Null between the upload and the creation of the ticket it was uploaded for
  ticketId     String?
  ticket       Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([uploadedById, ticketId])
}

model Comment {
  id          String   @id @default(cuid())
  content     String
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model TicketHistory {
  id             String   @id @default(cuid())
  action         String
  /// Event type (see lib/history.ts); null for rows written before events existed
  event          String?
  /// JSON data for the event, e.g. {"from":"OPEN","to":"ASSIGNED"}
  meta           String?
  overrideReason String?
  createdAt      DateTime @default(now())

  // Relations
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
}

/// Fixed-window attempt counters for rate limiting (lib/rate-limit.ts)
model RateLimit {
  /// e.g. "login:account:alice@company.com"
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

model AppSettings {
  id                    String   @id @default("singleton")
  appName               String   @default("Smart Helpdesk")
  supportEmail          String   @default("support@company.com")
  defaultPriority       String   @default("MEDIUM")
  autoAssignmentEnabled Boolean  @default(true)
  notifyNewUser         Boolean  @default(true)
  notifyCriticalTicket  Boolean  @default(true)

  // SLA & Hours
  slaCriticalHours      Int      @default(4)
  slaHighHours          Int      @default(24)
  slaMediumHours        Int      @default(48)
  slaLowHours           Int      @default(72)
  businessHoursStart    String   @default("09:00")
  businessHoursEnd      String   @default("17:00")
  workDays              String   @default("[\"Sunday\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\"]")
  pauseSlaOnWeekends    Boolean  @default(true)

  // AI & Automation
  enableAiTriage        Boolean  @default(true)
  fallbackHeuristicsEnabled Boolean @default(true)

  // Registration & Security
  autoApproveDomain     String   @default("@company.com")
  maintenanceMode       Boolean  @default(false)

  // Dynamic Data
  categoriesList        String   @default("[\"Hardware\",\"Software\",\"Network\",\"Email & Communication\",\"Access & Permissions\",\"Printer\",\"Security\",\"Other\"]")
  cannedResponses       String   @default("[{\"id\":\"1\",\"title\":\"Password Reset\",\"content\":\"Your password has been reset. Temporary credentials dispatched.\"},{\"id\":\"2\",\"title\":\"Request Asset Tag\",\"content\":\"Please provide your computer Asset Tag barcode number.\"}]")

  updatedAt             DateTime @updatedAt
}
